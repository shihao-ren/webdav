# WebDAV 服务配置
# 复制为 .env 后按需修改：cp .env.example .env

# 监听地址与端口
WEBDAV_HOST=0.0.0.0
WEBDAV_PORT=8080

# 认证（单账号模式，兼容方式；多账号优先用下面的 accounts.json）
# 必填，建议用强随机密码，勿使用示例口令。明文经 Basic 传输，对外必须通过
# nginx/caddy 走 HTTPS（location 内记得 proxy_cache off;）。
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# 多账号（按服务最小权限拆分，推荐；配置后单账号会被忽略）
# 账号文件：JSON 对象，每账号一个用户。prefix 为空=桶根 admin（全量），
# 非空=该服务只能读写桶内自己的前缀。prefix 必须为小写字母/数字/连字符。
# 账号文件权限务必 600，已在 .gitignore 中忽略。
# WEBDAV_ACCOUNTS_FILE=/opt/webdav/conf/accounts.json
# 示例 accounts.json：
# {
#   "admin":    { "password": "强密码", "prefix": "" },
#   "kgviewer": { "password": "强密码", "prefix": "kg-viewer-backups" },
#   "vault":    { "password": "强密码", "prefix": "vault-backups" }
# }
# local 后端下各 prefix 对应磁盘根下同名子目录。

# 存储后端：local（本地磁盘，默认）或 oss（阿里云 OSS）
WEBDAV_BACKEND=local

# 单次上传大小上限（字节，默认 1073741824=1 GiB，0=不限制）。超限的 PUT 直接
# 拒绝（413，DoS 防护），防止公网被任一账号灌入超大 body 撑爆内存。
WEBDAV_MAX_UPLOAD_SIZE=1073741824

# 反向代理子路径挂载（如 nginx location /webdav/），留空表示根路径挂载
WEBDAV_MOUNT_PATH=

# local 模式的存储目录
WEBDAV_ROOT=./data

# oss 模式配置（WEBDAV_BACKEND=oss 时必填）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
