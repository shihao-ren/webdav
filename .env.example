# WebDAV 服务配置
# 复制为 .env 后按需修改：cp .env.example .env

# 监听地址与端口
WEBDAV_HOST=0.0.0.0
WEBDAV_PORT=8080

# 认证（必填，建议修改）
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=admin123

# 存储后端：local（本地磁盘，默认）或 oss（阿里云 OSS）
WEBDAV_BACKEND=local

# 反向代理子路径挂载（如 nginx location /webdav/），留空表示根路径挂载
WEBDAV_MOUNT_PATH=

# local 模式的存储目录
WEBDAV_ROOT=./data

# oss 模式配置（WEBDAV_BACKEND=oss 时必填）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
